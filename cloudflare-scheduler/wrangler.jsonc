{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-hype-timer",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "triggers": { "crons": ["1-59/5 * * * *"] },
  "vars": { "SCHEDULER_ENABLED": "false" },
  "observability": { "enabled": true }
}
